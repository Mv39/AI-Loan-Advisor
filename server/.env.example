# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# LLM wrapper (provided by the assessment)
LLM_BASE_URL=https://llm-wrapper-741152993481.asia-south1.run.app
LLM_API_TOKEN=replace-with-your-token
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
# Set to "false" to run fully deterministic (no LLM calls) - useful for demos/offline
LLM_ENABLED=true

# Auth (mocked identity provider, real JWT verification)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=1800

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200

# Chat retention (minutes) for in-memory sessions
SESSION_TTL_MINUTES=60

# Optional MongoDB persistence (omit for in-memory storage)
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=loan_advisor

# LLM circuit breaker: open after N consecutive failures, retry after cooldown
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_MS=30000

# Observability
METRICS_ENABLED=true
LOG_LEVEL=info
